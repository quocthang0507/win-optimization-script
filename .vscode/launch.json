{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "coreclr",
      "request": "launch",
      "name": "WinUI: Build and Run App",
      "preLaunchTask": "build WinUI app",
      "program": "${workspaceFolder}/src/app/bin/Debug/net10.0-windows10.0.19041.0/win-x64/WinOptimizationApp.exe",
      "args": [],
      "cwd": "${workspaceFolder}/src/app",
      "stopAtEntry": false
    },
    {
      "type": "coreclr",
      "request": "launch",
      "name": "WinUI: Run Published App (Release)",
      "preLaunchTask": "publish WinUI app release",
      "program": "${workspaceFolder}/src/app/bin/Release/net10.0-windows10.0.19041.0/win-x64/publish/WinOptimizationApp.exe",
      "args": [],
      "cwd": "${workspaceFolder}/src/app/bin/Release/net10.0-windows10.0.19041.0/win-x64/publish",
      "stopAtEntry": false
    },
    {
      "type": "PowerShell",
      "request": "launch",
      "name": "Release: Bump Version and Push Tag",
      "script": "${workspaceFolder}/scripts/Release.ps1",
      "args": [
        "-Version",
        "${input:releaseVersion}",
        "-Push"
      ],
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "releaseVersion",
      "type": "promptString",
      "description": "Release version, semantic format X.Y.Z",
      "default": "0.2.1"
    }
  ]
}
